@{
    ViewData["Title"] = "Inicio";
}

<div class="hero-section text-center">
    <h1 class="display-4">💰 Sistema de Historial de Gastos</h1>
    <p class="lead mt-3">Controla, organiza y visualiza todos tus gastos de forma sencilla y eficiente.</p>
    <a asp-controller="Gastos" asp-action="Index" class="btn btn-light btn-lg mt-3">
        Ver Historial de Gastos
    </a>
</div>

<div class="row text-center">
    <div class="col-md-4 mb-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <h3>📋 Registrar</h3>
                <p>Agrega nuevos gastos con descripción, monto, fecha y categoría.</p>
                <a asp-controller="Gastos" asp-action="Create" class="btn btn-primary">Nuevo Gasto</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <h3>📊 Consultar</h3>
                <p>Visualiza el historial completo de tus gastos ordenados por fecha.</p>
                <a asp-controller="Gastos" asp-action="Index" class="btn btn-info text-white">Ver Gastos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <h3>✏️ Gestionar</h3>
                <p>Edita o elimina gastos existentes de manera rápida y segura.</p>
                <a asp-controller="Gastos" asp-action="Index" class="btn btn-warning">Administrar</a>
            </div>
        </div>
    </div>
</div>